# =========================================================================
# Football Draft — environment template
# Copy to .env.local and fill in the values. .env.local is gitignored.
# =========================================================================

# --- Database (Neon Postgres) -------------------------------------------
# Create a free project at https://neon.tech, copy the connection string.
# Should look like: postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Auth.js -----------------------------------------------------------
# Generate with: openssl rand -hex 32   (or any 32+ random hex string)
AUTH_SECRET=

# On Vercel this is set automatically. For local dev, leave as http://localhost:3000
AUTH_URL=http://localhost:3000

# --- Google OAuth -------------------------------------------------------
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (type: Web application)
# 3. Authorized redirect URIs:
#      http://localhost:3000/api/auth/callback/google      (dev)
#      https://YOUR-DOMAIN.com/api/auth/callback/google    (prod)
# 4. Copy the Client ID + Client Secret here.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- App encryption key ------------------------------------------------
# Encrypts users' OpenAI API keys at rest in the database.
# Generate with: openssl rand -hex 32
# IMPORTANT: never change this once users have stored keys — they'll become
# undecryptable. Store this securely (Vercel project env vars).
APP_ENCRYPTION_KEY=
